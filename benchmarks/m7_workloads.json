{
  "schema_version": 1,
  "baseline": "0.32.0",
  "target_ratios": {
    "execution_time_max": 1.0,
    "peak_rss_max": 1.0
  },
  "native_image_targets": {
    "execution_time_max": 1.0,
    "peak_rss_max": 1.0,
    "required_for_cli_server_pkldoc": true,
    "eligible_modes": ["cold-cli", "steady-server"],
    "expected_eligible_workload_count": 15,
    "repl_jline_stderr_note": "Official Apple Pkl 0.32.0 native-image pkl repl reads System.getProperty(\"user.home\")/.pkl/repl-history via JLine and may emit benign JLine history log lines to stderr; Rust pkl repl remains strictly verified for stderr == b\"\" and 100% raw-byte stdout parity."
  },
  "browser_wasm_targets": {
    "execution_time_max": 1.0,
    "wasm_linear_memory_ratio_max": 0.15,
    "js_heap_used_max_bytes": 67108864,
    "wasm_binary_gzip_max_bytes": 2621440,
    "engine_time_exceptions": {
      "firefox": {
        "typed-conversion": {
          "execution_time_max": 1.5,
          "reason": "Explicit Firefox SpiderMonkey typed-conversion boundary exception (2026-11-22); Firefox eval-text remains <= 1.00x and functional raw-byte parity remains strictly required."
        }
      }
    }
  },
  "profiles": {
    "full": {
      "cold_samples": 5,
