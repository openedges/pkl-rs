  "audit_helper": {
    "path": "target/m2/stage19-post-seal-helper-final-01.py",
    "sha256": "0e13bc10160d203c2429c7814faeb1be264f170a153fb2e8e9f1e50fbd14664f",
    "bytes": 4649,
    "source_utf8": "\"\"\"Read-only verification of Stage19 sealed archives, source proof and gate outcomes.\"\"\"\nfrom pathlib import Path\nimport datetime,hashlib,json,subprocess,sys,tarfile\nroot=Path.cwd();sys.path.insert(0,str(root/'tools'));import evidence\nsha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()\nread=lambda p:json.loads(p.read_bytes())\nsummary_path=root/'reports/m2/stage19-final-summary.json';summary=read(summary_path)\nprocess_path=root/'target/m2/stage19-package-captured-final-01/process.json';process=read(process_path)\nassert process['exit_code']==0 and process['helper']['stable']\nassert process['helper']['sha256_before']==summary['packaging_helper']['sha256']==process['helper']['sha256_after']\nrecords=dict(summary['archives'])\nfor index,row in enumerate(summary['exploration']['support_archives']):records['exploration-support-'+str(index+1)]=row\narchives=[]\nfor name,row in records.items():\n path=root/row['path'];assert sha(path)==row['sha256'] and path.stat().st_size==row['bytes'],name\n evidence.verify(path)\n archives.append(dict(name=name,**row,hash_size_and_inventory_verified=True))\nhistorical=[]\nfor name,row in summary['historical_dependencies']['archives'].items():\n path=root/row['path'];assert sha(path)==row['sha256'] and path.stat().st_size==row['bytes'],name\n historical.append(dict(name=name,path=row['path'],sha256=row['sha256'],bytes=row['bytes'],hash_size_verified=True,payload_rewritten=False))\nwith tarfile.open(root/summary['archives']['source']['path']) as stream:\n binding=json.load(stream.extractfile('source-verification.json'))\n assert hashlib.sha256(stream.extractfile('git-proof/request.bin').read()).hexdigest()==binding['git_request_sha256']\n assert hashlib.sha256(stream.extractfile('git-proof/stdout.bin').read()).hexdigest()==binding['git_response_sha256']\n helper=stream.extractfile('package_stage19_final.py').read();assert hashlib.sha256(helper).hexdigest()==summary['packaging_helper']['sha256']\n preflight=json.load(stream.extractfile('packaging-execution-preflight/invocation.json'));assert preflight['helper']['sha256']==summary['packaging_helper']['sha256']\n implementation={row['path']:row['sha256'] for row in binding['copies']}\n for name,digest in implementation.items():assert hashlib.sha256(stream.extractfile('implementation-sources/'+name).read()).hexdigest()==digest\n gate_rows=json.load(stream.extractfile('gates/report.json'));assert gate_rows==summary['gates']\n for row in gate_rows:\n  assert row['exit_code']==row['expected_exit_code']\n  for channel in ['stdout','stderr']:assert hashlib.sha256(stream.extractfile('gates/'+row['gate']+'.'+channel+'.bin').read()).hexdigest()==row[channel+'_sha256']\n for name,row in summary['independent_reviews'].items():assert hashlib.sha256(stream.extractfile(name).read()).hexdigest()==row['sha256']\nassert not summary['missing_or_running_suites']\nassert not summary['compatibility_complete'] and not summary['performance_targets_established']\nassert not summary['captured_binaries_executed_by_packaging']\ncode=Path(__file__).read_bytes()\nreport=dict(schema=1,utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),status='pass',implementation_commit=summary['implementation_commit'],scope='Read-only checksum, archive-inventory, immutable-helper, exact source-copy and gate-result verification. No retained binary was executed.',summary=dict(path=str(summary_path.relative_to(root)),sha256=sha(summary_path)),packaging_process=dict(path=str(process_path.relative_to(root)),sha256=sha(process_path),exit_code=process['exit_code'],helper_stable=True),archives=archives,historical_dependencies=historical,source_binding=dict(source_snapshot_copies=binding['source_snapshot_copies'],unique_source_files=binding['unique_source_files'],upstream_source_snapshot_copies=binding['upstream_source_snapshot_copies'],all_enumerated_implementation_source_payload_hashes_verified=True,git_request_response_hashes_verified=True),gates=gate_rows,independent_reviews=summary['independent_reviews'],compatibility_complete=False,performance_targets_established=False,retained_binaries_executed=False,audit_helper=dict(path=str(Path(__file__).resolve().relative_to(root)),sha256=hashlib.sha256(code).hexdigest(),bytes=len(code),source_utf8=code.decode()))\nout=root/'reports/m2/stage19-post-seal-audit.json'\nwith out.open('x') as f:json.dump(report,f,indent=2);f.write('\\n')\nprint(json.dumps(dict(status='verified',new_archives=len(archives),historical_archive_hashes=len(historical),source_snapshot_copies=binding['source_snapshot_copies'],unique_source_files=binding['unique_source_files'],audit_path=str(out.relative_to(root)),audit_sha256=sha(out)),indent=2))\n"
  }
}
