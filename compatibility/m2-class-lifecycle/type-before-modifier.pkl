open class Base { fixed value: Int = 42 }
class Child extends Base { early: Int = 10; value: Missing = 1; later: Int = 99 }
trigger = Child == Child
inherited = new Child {}.value
early = new Child {}.early
later = new Child {}.later
assigned = new Child { value = 1 }.value
freshAssigned = new Child { fresh = 77 }.fresh
tailAssigned = new Child { later = 88 }.later
identity = Child == Child
ordinary = throw("ordinary failure")
