{
  "name": "@openedges/pkl-napi",
  "version": "0.32.0-rc.2",
  "description": "Node.js N-API bindings for the shared pure-Rust Apple Pkl 0.32.0 engine",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/openedges/pkl-rs.git",
    "directory": "packages/pkl-napi"
  },
  "homepage": "https://github.com/openedges/pkl-rs/tree/main/packages/pkl-napi#readme",
  "bugs": {
    "url": "https://github.com/openedges/pkl-rs/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "native",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "pklPlatformSupport": {
    "runtime": "napi-node",
    "napiVersion": 8,
    "linuxGlibcMinimum": "2.28",
    "targets": [
      "darwin-arm64",
      "darwin-x64",
      "linux-x64-gnu",
      "linux-arm64-gnu",
      "linux-x64-musl",
      "linux-arm64-musl",
      "win32-x64-msvc"
    ]
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "test": "node ./test/run.mjs"
  },
  "keywords": [
    "pkl",
    "apple-pkl",
    "configuration",
    "napi",
    "rust",
    "nodejs"
  ]
}
