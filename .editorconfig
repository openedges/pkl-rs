root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{toml,yml,yaml,json,md}]
indent_size = 2

[external/**]
charset = unset
end_of_line = unset
insert_final_newline = false
trim_trailing_whitespace = false
indent_style = unset
indent_size = unset

[tests/{fixtures,golden}/**]
charset = unset
end_of_line = unset
insert_final_newline = false
trim_trailing_whitespace = false
