module stage98
function pcfLower(s) = (new PcfRenderer { converters { [String] = (v) -> trace(v.toLowerCase()) } }).renderDocument(s)
function propertiesLower(s) = (new PropertiesRenderer { converters { [String] = (v) -> trace(v.toLowerCase()) } }).renderDocument(s)
function pcfIdentity(s) = (new PcfRenderer { converters { [String] = (v) -> trace(v) } }).renderDocument(s)
function jsonLower(s) = (new JsonRenderer { converters { [String] = (v) -> trace(v.toLowerCase()) } }).renderDocument(s)
function pcfValueLower(s) = (new PcfRenderer { converters { [String] = (v) -> trace(v.toLowerCase()) } }).renderValue(s)
function pcfPlain(s) = (new PcfRenderer {}).renderDocument(s)
