act"); name = "ceil"; allModifiers = Set("abstract"); allAnnotations = List() }, "floor", new Property { location { line = 881; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L881" }; docComment = "Rounds this number to the next mathematical integer towards -[Infinity].\n\nIf [this] is an [Int], returns [this].\nIf [this] is [NaN], [Infinity], -[Infinity], `0.0`, or `-0.0`, returns [this].\nOtherwise, returns the largest [Float] that is less than or equal to [this]\nand is equal to a mathematical integer."; annotations = List(); modifiers = Set("abstract"); name = "floor"; allModifiers = Set("abstract"); allAnnotations = List() }, "isPositive", new Property { location { line = 949; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L949" }; docComment = "Tells if this number is greater than or equal to zero.\n\nFacts:\n```\n0.isPositive\n(-0).isPositive\n0.0.isPositive\n(-0.0).isPositive\n3.isPositive\n3.14.isPositive\nInfinity.isPositive\n\n!(-3).isPositive\n!(-3.14).isPositive\n!(-Infinity).isPositive\n!NaN.isPositive\n```"; annotations = List(); modifiers = Set("abstract"); name = "isPositive"; allModifiers = Set("abstract"); allAnnotations = List() }, "isFinite", new Property { location { line = 952; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L952" }; docComment = "Tells if this number is neither [NaN] nor [isInfinite]."; annotations = List(); modifiers = Set("abstract"); name = "isFinite"; allModifiers = Set("abstract"); allAnnotations = List() }, "isInfinite", new Property { location { line = 955; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L955" }; docComment = "Tells if this number is [Infinity] or -[Infinity]."; annotations = List(); modifiers = Set("abstract"); name = "isInfinite"; allModifiers = Set("abstract"); allAnnotations = List() }, "isNaN", new Property { location { line = 962; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L962" }; docComment = "Tells if this number is [NaN].\n\nAlways use this method when testing for [NaN].\nNote that `x == NaN` is *not* a correct way to test for [NaN] because `NaN != NaN` as per the\nIEEE spec."; annotations = List(); modifiers = Set("abstract"); name = "isNaN"; allModifiers = Set("abstract"); allAnnotations = List() }, "isNonZero", new Property { location { line = 965; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L965" }; docComment = "Tells if this number is not 0."; annotations = List(); modifiers = Set("abstract"); name = "isNonZero"; allModifiers = Set("abstract"); allAnnotations = List() }); methods = Map("round", new Method { location { line = 891; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L891" }; docComment = "Rounds this number to the nearest mathematical integer, breaking ties in favor\nof the even integer.\n\nIf [this] is an [Int], returns [this].\nIf [this] is [NaN], [Infinity], -[Infinity], `0.0`, or `-0.0`, returns [this].\nOtherwise, return the [Float] that is nearest to [this] and is equal to a\nmathematical integer. If two mathematical integers are equally near, returns\nthe even integer."; annotations = List(); modifiers = Set("abstract"); name = "round"; typeParameters = List(); parameters = Map() }, "truncate", new Method { location { line = 902; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L902" }; docComment = "Rounds this number to the next mathematical integer towards zero.\n\nIf [this] is an [Int], returns [this].\nIf [this] is [NaN], [Infinity], -[Infinity], `0.0`, or `-0.0`, returns [this].\nIf [this] is less than zero, returns the smallest [Float] that is greater than or equal to\n[this] and is equal to a mathematical integer.\nOtherwise, returns the largest [Float] that is less than or equal to [this]\nand is equal to a mathematical integer."; annotations = List(); modifiers = Set("abstract"); name = "truncate"; typeParameters = List(); parameters = Map() }, "toInt", new Method { location { line = 910; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L910" }; docComment = "Converts this number to an [Int].\n\nIf [this] is an [Int], returns [this].\nIf [this] is [NaN], [Infinity], or -[Infinity], throws an error.\nOtherwise, returns the [Int] representation for `this.truncate()`.\nIf `this.truncate()` is not representable in (that is, too large for) [Int], throws an error."; annotations = List(); modifiers = Set("abstract"); name = "toInt"; typeParameters = List(); parameters = Map() }, "toFloat", new Method { location { line = 917; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L917" }; docComment = "Converts this number to a [Float].\n\nIf [this] is a [Float], returns [this].\nOtherwise, returns the [Float] representation for [this].\nIf [this] is not representable in [Float], returns the [Float] nearest to [this]."; annotations = List(); modifiers = Set("abstract"); name = "toFloat"; typeParameters = List(); parameters = Map() }, "toString", new Method { location { line = 920; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L920" }; docComment = "Converts this number to its decimal string representation."; annotations = List(); modifiers = Set("abstract"); name = "toString"; typeParameters = List(); parameters = Map() }, "toFixed", new Method { location { line = 924; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L924" }; docComment = "Converts this number to a decimal fixed-point representation with [fractionDigits] digits\nafter the decimal point."; annotations = List(); modifiers = Set("abstract"); name = "toFixed"; typeParameters = List(); parameters = Map("fractionDigits", new MethodParameter { name = "fractionDigits" }) }, "toDuration", new Method { location { lin