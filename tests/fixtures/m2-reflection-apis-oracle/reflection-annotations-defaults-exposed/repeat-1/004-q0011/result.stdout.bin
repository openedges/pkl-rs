distinctBy"; typeParameters = List(); parameters = Map("selector", new MethodParameter { name = "selector" }) }, "every", new Method { location { line = 2204; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L2204" }; docComment = "Tells if [predicate] holds for every element of this listing.\n\nReturns [true] for an empty listing."; annotations = List(new Since { version = "0.27.0" }); modifiers = Set(); name = "every"; typeParameters = List(); parameters = Map("predicate", new MethodParameter { name = "predicate" }) }, "any", new Method { location { line = 2210; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L2210" }; docComment = "Tells if [predicate] holds for at least one element of this listing.\n\nReturns [false] for an empty listing."; annotations = List(new Since { version = "0.27.0" }); modifiers = Set(); name = "any"; typeParameters = List(); parameters = Map("predicate", new MethodParameter { name = "predicate" }) }, "contains", new Method { location { line = 2222; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L2222" }; docComment = "Tests if [element] is contained in this listing.\n\nFacts:\n```\nnew Listing { 1 ; 2 ; 3 }.contains(1)\nnew Listing { 1 ; 2 ; 3 }.contains(2)\nnew Listing { 1 ; 2 ; 3 }.contains(3)\n!new Listing { 1 ; 2 ; 3 }.contains(4)\n```"; annotations = List(new Since { version = "0.27.0" }); modifiers = Set(); name = "contains"; typeParameters = List(); parameters = Map("element", new MethodParameter { name = "element" }) }, "fold", new Method { location { line = 2225; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L2225" }; docComment = "Folds this listing in iteration order using [operator], starting with [initial]."; annotations = List(); modifiers = Set(); name = "fold"; typeParameters = List(new TypeParameter { name = "Result"; variance = null }); parameters = Map("initial", new MethodParameter { name = "initial" }, "operator", new MethodParameter { name = "operator" }) }, "foldIndexed", new Method { location { line = 2230; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L2230" }; docComment = "Folds this listing in iteration order using [operator], starting with [initial].\n\nThe first parameter of [operator] is the zero-based index of the current element."; annotations = List(); modifiers = Set(); name = "foldIndexed"; typeParameters = List(new TypeParameter { name = "Result"; variance = null }); parameters = Map("initial", new MethodParameter { name = "initial" }, "operator", new MethodParameter { name = "operator" }) }, "join", new Method { location { line = 2237; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L2237" }; docComment = "Converts the elements of this listing to strings and concatenates them inserting [separator]\nbetween elements."; annotations = List(); modifiers = Set(); name = "join"; typeParameters = List(); parameters = Map("separator", new MethodParameter { name = "separator" }) }, "toList", new Method { location { line = 2240; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L2240" }; docComment = "Converts this listing to a [List]."; annotations = List(); modifiers = Set(); name = "toList"; typeParameters = List(); parameters = Map() }, "toSet", new Method { location { line = 2243; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L2243" }; docComment = "Converts this listing to a [Set]."; annotations = List(); modifiers = Set(); name = "toSet"; typeParameters = List(); parameters = Map() }) }; typeArguments = List(new DeclaredType { referent { location { line = 993; column = 1; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L993" }; docComment = "A 64-bit signed integer.\n\nThe following operators are supported for [Number]s:\n```\n-a     // negation\na + b  // addition\na - b  // subtraction\na * b  // multiplication\na / b  // division\na ~/ b // truncating division\na % b  // remainder\na ** b // exponentiation\n```"; annotations = List(); modifiers = Set("external"); name = "Int"; typeParameters = List(); superclass { location { line = 741; column = 1; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L741" }; docComment = "Common base class of [Int] and [Float].\n\n## Arithmetic Operators\n```\n-a     // negation\na + b  // addition\na - b  // subtraction\na * b  // multiplication\na / b  // division\na ~/ b // integer division\na % b  // remainder\na ** b // exponentiation\n```\n\n## Comparison Operators\n```\na == b // equality\na != b // inequality\na < b  // less than\na > b  // greater than\na <= b // less than or equal\na >= b // greater than or equal\n```\n\n## Number vs. Float\nTo allow transparent use of [Float] and [Int],\nuse [Number] instead of [Float] in type annotations."; annotations = List(); modifiers = Set("abstract", "external"); name = "Number"; typeParameters = List(); superclass { location { line = 47; column = 1; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L47" }; docComment = "The top type of the type hierarchy.\n\nEvery type is a subtype of [Any].\n\nThe following operators are supported for all values:\n\n```\nvalue1 == value2 // equality\nvalue1 != value2 // inequality\nvalue.member     // member access\nvalue?.member    // conditional member access; returns `value.member` if `value` is non-null and `null` otherwise\nvalue ?? default // null coalescing; returns `value` if `value` is non-null and `default` otherwise\nvalue!!          // non-null assertion; throws if `value` is `null`, and returns `value` otherwise\nvalue is String  // type test\nvalue as String  // type cast; throws an error unless `value is String`\n```"; annotations = List(); modifiers = Set("abstract", "external"); name = "Any"; typeParameters = List(); superclass = null; supertype = null; properties = Map(); allProperties = Map(); methods = Map("getClass", new Method { location { line = 49; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L49" }; docComment = "Returns the class of [this]."; annotations = List(); modifiers = Set(); name = "getClass"; typeParameters = List(); parameters = Map() }, "toString", new Method { location { line = 54; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L54" }; docComment = "Returns a string representation of [this].\n\nThis method is used to convert the values of string interpolation expressions to strings."; annotations = List(); modifiers = Set(); name = "toString"; typeParameters = List(); parameters = Map() }, "ifNonNull", new Method { location { line = 60; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L60" }; docComment = "Returns `this |> transform` if [this] is non-null, and [null] otherwise.\n\nThis method is the complement of the `??` operator and the equivalent of an `Option` type's\n`map` and `flatMap` methods."; annotations = List(); modifiers = Set(); name = "ifNonNull"; typeParameters = List(new TypeParameter { name = "Result"; variance = null }); parameters = Map("transform", new MethodParameter { name = "transform" }) }); allMethods = Map("getClass", new Method { location { line = 49; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L49" }; docComment = "Returns the class of [this]."; annotations = List(); modifiers = Set(); name = "getClass"; typeParameters = List(); parameters = Map() }, "toString", new Method { location { line = 54; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L54" }; docComment = "Returns a string representation of [this].\n\nThis method is used to convert the values of string interpolation expressions to strings."; annotations = List(); modifiers = Set(); name = "toString"; typeParameters = L