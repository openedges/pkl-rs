a mathematical integer."; annotations = List(); modifiers = Set("abstract"); name = "ceil"; allModifiers = Set("abstract"); allAnnotations = List() }, "floor", new Property { location { line = 881; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L881" }; docComment = "Rounds this number to the next mathematical integer towards -[Infinity].\n\nIf [this] is an [Int], returns [this].\nIf [this] is [NaN], [Infinity], -[Infinity], `0.0`, or `-0.0`, returns [this].\nOtherwise, returns the largest [Float] that is less than or equal to [this]\nand is equal to a mathematical integer."; annotations = List(); modifiers = Set("abstract"); name = "floor"; allModifiers = Set("abstract"); allAnnotations = List() }, "isPositive", new Property { location { line = 949; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L949" }; docComment = "Tells if this number is greater than or equal to zero.\n\nFacts:\n```\n0.isPositive\n(-0).isPositive\n0.0.isPositive\n(-0.0).isPositive\n3.isPositive\n3.14.isPositive\nInfinity.isPositive\n\n!(-3).isPositive\n!(-3.14).isPositive\n!(-Infinity).isPositive\n!NaN.isPositive\n```"; annotations = List(); modifiers = Set("abstract"); name = "isPositive"; allModifiers = Set("abstract"); allAnnotations = List() }, "isFinite", new Property { location { line = 952; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L952" }; docComment = "Tells if this number is neither [NaN] nor [isInfinite]."; annotations = List(); modifiers = Set("abstract"); name = "isFinite"; allModifiers = Set("abstract"); allAnnotations = List() }, "isInfinite", new Property { location { line = 955; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L955" }; docComment = "Tells if this number is [Infinity] or -[Infinity]."; annotations = List(); modifiers = Set("abstract"); name = "isInfinite"; allModifiers = Set("abstract"); allAnnotations = List() }, "is