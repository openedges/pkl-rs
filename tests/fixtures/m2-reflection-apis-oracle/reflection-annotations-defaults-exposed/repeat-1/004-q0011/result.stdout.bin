 }) }); methods = Map("getOrNull", new Method { location { line = 2100; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L2100" }; docComment = "Returns the element at [index].\n\nReturns [null] if [index] is outside the bounds of this listing.\n\nFacts:\n```\nnew Listing { 3 ; 9 ; 6 }.getOrNull(0) == 3\nnew Listing { 3 ; 9 ; 6 }.getOrNull(1) == 9\nnew Listing { 3 ; 9 ; 6 }.getOrNull(2) == 6\nnew Listing { 3 ; 9 ; 6 }.getOrNull(-1) == null\nnew Listing { 3 ; 9 ; 6 }.getOrNull(3) == null\nnew Listing { 3 ; 9 ; 6 }.getOrNull(99) == null\n```"; annotations = List(new Since { version = "0.27.0" }); modifiers = Set(); name = "getOrNull"; typeParameters = List(); parameters = Map("index", new MethodParameter { name = "index" }) }, "getOrDefault", new Method { location { line = 2108; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L2108" }; docComment = "Returns the element at [index].\n\nReturns [default] applied to [index] if [index] is outside the bounds of this listing.\n\nThis is equivalent to `getOrNull(index) ?? default.apply(index)`."; annotations = List(new Since { version = "0.29.0" }); modifiers = Set(); name = "getOrDefault"; typeParameters = List(); parameters = Map("index", new MethodParameter { name = "index" }) }, "isDistinctBy", new Method { location { line = 2128; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L2128" }; docComment = "Tells if this listing has no elements that are duplicates after applying [selector].\n\nFacts:\n```\nnew Listing { \"a\"; \"ab\"; \"abc\" }.isDistinctBy((it) -> it.length)\n!new Listing { \"a\"; \"ab\"; \"c\" }.isDistinctBy((it) -> it.length)\n```"; annotations = List(new AlsoKnownAs { names { "isUniqueBy" } }); modifiers = Set(); name = "isDistinctBy"; typeParameters = List(); parameters = Map("selector", new MethodParameter { name = "selector" }) }, "distinctBy", new Method { location { line = 2198; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L2198" }; docComment = "Removes elements that are duplicates after applying [selector] from this listing, preserving\nthe first occurrence.\n\nFacts:\n```\nnew Listing { \"a\"; \"ab\"; \"abc\" }.distinctBy((it) -> it.length) == new Listing { \"a\"; \"ab\"; \"abc\" }\nnew Listing { \"a\"; \"ab\"; \"c\" }.distinctBy((it) -> it.length) == new Listing { \"a\"; \"ab\" }\n```"; annotations = List(new AlsoKnownAs { names { "uniqueBy" } }); modifiers = Set(); name = "distinctBy"; typeParameters = List(); parameters = Map("selector", new MethodParameter { name = "selector" }) }, "every", new Method { location { line = 2204; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L2204" }; docComment = "Tells if [predicate] holds for every element of this listing.\n\nReturns [true] for an empty listing."; annotations = List(new Since { version = "0.27.0" }); modifiers = Set(); name = "every"; typeParameters = List(); parameters = Map("predicate", new MethodParameter { name = "predicate" }) }, "any", new Method { location { line = 2210; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L2210" }; docComment = "Tells if [predicate] holds for at least one element of this listing.\n\nReturns [false] for an empty listing."; annotations = List(new Since { version = "0.27.0" }); modifiers = Set(); name = "any"; typeParameters = List(); parameters = Map("predicate", new MethodParameter { name = "predicate" }) }, "contains", new Method { location { line = 2222; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L2222" }; docComment = "Tests if [element] is contained in this listing.\n\nFacts:\n```\nnew Listing { 1 ; 2 ; 3 }.contains(1)\nnew Listing { 1 ; 2 ; 3 }.contains(2)\nnew Listing { 1 ; 2 ; 3 }.contains(3)\n!new Listing { 1 ; 2 ; 3 }.contains(4)\n```"; annotations = List(new Since { version = "0.27.0" }); modifiers = Set(); name = "contains"; typeParameters = List(); parameters = Map("element", new MethodParameter { name = "element" }) }, "fold", new Method { location { line = 2225; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L2225" }; docComment = "Folds this listing in iteration order using [operator], starting with [initial]."; annotations = List(); modifiers = Set(); name = "fold"; typeParameters = List(new TypeParameter { name = "Result"; variance = null }); parameters = Map("initial", new MethodParameter { name = "initial" }, "operator", new MethodParameter { name = "operator" }) }, "foldIndexed", new Method { location { line = 2230; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L2230" }; docComment = "Folds this listing in iteration order using [operator], starting with [initial].\n\nThe first parameter of [operator] is the zero-based index of the current element."; annotations = List(); modifiers = Set(); name = "foldIndexed"; typeParameters = List(new TypeParameter { name = "Result"; variance = null }); parameters = Map("initial", new MethodParameter { name = "initial" }, "operator", new MethodParameter { name = "operator" }) }, "join", new Method { location { line = 2237; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L2237" }; docComment = "Converts the elements of this listing to strings and concatenates them inserting [separator]\nbetween elements."; annotations = List(); modifiers = Set(); name = "join"; typeParameters = List(); parameters = Map("separator", new MethodParameter { name = "separator" }) }, "toList", new Method { location { line = 2240; column = 3; displayUri = "https://github.com/apple/pkl/blob/0.32.0/stdlib/base.pkl#L2240" }; docComment = "Converts this listing to a [List]."; annotations = List(); modifiers = Set(); name = "toList"; typeParameters = List(); parameters = Map() }, "toSet", new Method { location { line = 2243; column = 3; displayUri = "