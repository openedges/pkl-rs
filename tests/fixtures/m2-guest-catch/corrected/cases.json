    "id": "stdlib-singleton-and-builtin-identity",
    "mode": "plain",
    "source": "import \"pkl:base\" as b\nimport \"pkl:base\" as b2\nimport \"pkl:test\" as t\nimport \"pkl:test\" as t2\nimport \"pkl:ref\" as r\nimport \"pkl:ref\" as r2\nbaseSame = b == b2\ntestSame = t == t2\nrefSame = r == r2\nbaseIntSame = b.Int == Int\nbaseModuleSame = b.Module == Module\nbaseDistinct = this != b\nstdDistinct = b != t && t != r && b != r\ntestClassSame = t.getClass() == t2.getClass()\nunknownModule = t.catch(() -> import(\"pkl:missingStage45\"))\n",
    "expressions": [
      "baseSame",
      "testSame",
      "refSame",
      "baseIntSame",
      "baseModuleSame",
      "baseDistinct",
      "stdDistinct",
      "testClassSame",
      "unknownModule",
      "baseSame"
    ],
