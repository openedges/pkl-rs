import "pkl:protobuf"

class Input {
value: Listing<Int> | String="seed"
tail=new RenderDirective { text=read("proto:tail"); bytes=throw("unused") }
}
output { value=new Input {}; renderer=new protobuf.Renderer { indent=trace(".."); converters { ["value"]=(_)->if (trace(read("proto:convert")) == "yes") new Listing { trace(read("proto:element")) } else throw("conversion") }
} }
