import "pkl:ref"
class D extends ref.Domain { function renderReference(r): String = "ok" }
local d = new D {}
class LazyDomain extends ref.Domain { p = throw("hash domain forced"); function renderReference(r): String = "ok" }
local key = ref.Reference(new LazyDomain {}, String, null)
local m = new Mapping { [key] = "present" }
result = m.length
