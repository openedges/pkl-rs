import "pkl:ref"
class D extends ref.Domain {
  function renderReference(r): String = r.getData().toString()
}
local d = new D {}
class H { p: String | Int | Boolean; q: Boolean | String | Int }
result = (ref.Reference(d, H, null).p is ref.Reference<D, Boolean | Int | String>) && (ref.Reference(d, H, null).q is ref.Reference<D, String | Boolean | Int>)
