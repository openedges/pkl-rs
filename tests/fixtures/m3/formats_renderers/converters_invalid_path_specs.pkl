import "pkl:test"

local specs = List(
  "^^",
  "property.",
  "property^",
  ".property",
  "prop1..prop2",
  "[key",
  "key]",
  "[[key]]",
  "property.[key]",
  "[key1].[key2]",
  "[key1] [key2]",
  "**",
  "[**]",
  "[*"
)

errors = specs.map((spec) -> Pair(spec, test.catch(() ->
  new PcfRenderer {
    converters {
      [spec] = (v) -> v
    }
  }.renderValue(new Dynamic { property = 1 })
)))
