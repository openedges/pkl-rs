local doc = List(new Dynamic { foo { bar = 0; empty = null } })
r00 = new YamlRenderer { omitNullProperties = false; isStream = false }.renderDocument(doc)
r01 = new YamlRenderer { omitNullProperties = false; isStream = true }.renderDocument(doc)
r10 = new YamlRenderer { omitNullProperties = true; isStream = false }.renderDocument(doc)
r11 = new YamlRenderer { omitNullProperties = true; isStream = true }.renderDocument(doc)
checks = List(r00.endsWith("\n"), r01.endsWith("\n"), r10.endsWith("\n"), r11.endsWith("\n"))
